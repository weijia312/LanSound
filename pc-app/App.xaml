<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="pc_app.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 控件样式（必须，否则控件退回系统默认模板） -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 卡片叠加层随主题翻转。
                 放在 Application.Resources 而不是某个页面的 Grid.Resources ——
                 ThemeDictionaries 要求宿主是完整的 ResourceDictionary，
                 页面的 Resources 属性不满足，会报 WMC9997/WMC9999。 -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- 未连接：WinUI 默认浅底 #F3F3F3。底色已经很浅，只能往深里压。 -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardFillBrush" Color="#0D000000" />
                    <SolidColorBrush x:Key="CardEdgeBrush" Color="#14000000" />
                </ResourceDictionary>
                <!-- 已连接：深绿 #0F5C0C。深底要往浅里提。 -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardFillBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="CardEdgeBrush" Color="#26FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
