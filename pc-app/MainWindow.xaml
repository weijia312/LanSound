<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="pc_app.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 底色：未连接用 WinUI 默认窗口底色（#F3F3F3），已连接用深绿（#0F5C0C）。
         RequestedTheme 由代码按连接状态切换（浅底配深字、深绿底配浅字）。
         界面文案一律不写在这里 —— 语言是运行时才确定的，全部由 Strings 在代码里设置。 -->
    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Light" MinWidth="480" MinHeight="640">
        <Grid.Resources>
            <!-- 卡片叠加层用的 CardFillBrush / CardEdgeBrush 定义在 App.xaml 的
                 ThemeDictionaries 里（会随 RequestedTheme 自动翻转）：
                 浅底叠黑变深、深绿底叠白变浅，方向相反，所以必须分主题给。 -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardFillBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardEdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- 运行日志：等宽字体，便于对齐时间戳 -->
            <Style x:Key="LogItemStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
        </Grid.Resources>

        <Grid Margin="20,16,20,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 0. 状态行（文案由 Strings 设置） -->
            <TextBlock x:Name="StatusText" Grid.Row="0" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

            <!-- 1. 二维码 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" HorizontalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock x:Name="QrHeader" Style="{StaticResource CardHeaderStyle}" />
                    <!-- 这层白底要保留：二维码黑块必须有足够静区才能被扫到，
                         透明或半透明底会让手机难以识别 -->
                    <Border Background="White" CornerRadius="6" Padding="8">
                        <Image x:Name="QrImage" Width="168" Height="168" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="CertHintText" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 2. 访问地址：网卡 IP + 地址 + 端口。
                 端口不另加标签 —— 它紧跟 URL 之后、又是纯数字框，标签属于冗余。 -->
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="IpCombo" Grid.Column="0" MinWidth="132"
                          SelectionChanged="IpCombo_SelectionChanged" />
                <TextBox x:Name="UrlText" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" />
                <TextBox x:Name="PortText" Grid.Column="2" Width="66" VerticalAlignment="Center"
                         InputScope="Number" MaxLength="5" />
            </Grid>

            <!-- 3. 设置：音质行横排，开机自启单独一行 -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12,12,12,12">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="SettingsHeader" Style="{StaticResource CardHeaderStyle}" />

                    <!-- 3.1 音质：标签 + 两个单选项横排（圆点挨着哪个词就是哪个模式） -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="QualityLabel" FontSize="13" VerticalAlignment="Center" />
                            <RadioButton x:Name="ModeHighQuality" GroupName="AudioMode"
                                         MinWidth="0" VerticalAlignment="Center"
                                         Checked="AudioMode_Checked" />
                            <RadioButton x:Name="ModeLowLatency" GroupName="AudioMode"
                                         MinWidth="0" VerticalAlignment="Center"
                                         Checked="AudioMode_Checked" />
                        </StackPanel>
                        <TextBlock x:Name="AudioModeHint" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 3.2 开机自启 -->
                    <StackPanel Spacing="4">
                        <CheckBox x:Name="AutoStartCheck" MinWidth="0"
                                  Checked="AutoStart_Toggled" Unchecked="AutoStart_Toggled" />
                        <TextBlock x:Name="AutoStartHint" FontSize="12" TextWrapping="Wrap" Margin="4,0,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. 使用提示（固定文案，内容与标题都由 Strings 设置） -->
            <InfoBar x:Name="HintBar" Grid.Row="4" IsOpen="True" IsClosable="False"
                     Severity="Informational" />

            <!-- 5. 运行日志 -->
            <Border Grid.Row="5" Style="{StaticResource CardStyle}" Padding="16,12,16,8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LogHeader" Style="{StaticResource CardHeaderStyle}" />
                    <ListView x:Name="LogList" Grid.Row="1" SelectionMode="None"
                              Background="Transparent" BorderThickness="0" Padding="0"
                              ScrollViewer.HorizontalScrollMode="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource LogItemStyle}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
